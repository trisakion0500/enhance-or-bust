PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_APP_DATABASE=enhance_or_bust
MONGO_APP_USERNAME=changeme
MONGO_APP_PASSWORD=changeme
MONGO_APP_DATABASE_LOG=enhance_or_bust_log
MONGO_APP_USERNAME_LOG=changeme
MONGO_APP_PASSWORD_LOG=changeme
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=changeme
# 로컬 Redis 하나를 여러 프로젝트가 같이 쓸 때 키 충돌 방지용 프리픽스
REDIS_KEY_PREFIX=eob:
GOOGLE_CLIENT_ID=changeme
# id_token(Google Identity Services, 기본값) 또는 authorization_code
GOOGLE_AUTH_FLOW=id_token
# authorization_code 플로우에서만 필요
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FACEBOOK_APP_ID=changeme
FACEBOOK_APP_SECRET=changeme
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback
# 만료 우편 정리 배치 스케줄(cron 표현식) — 기본 매월 1일 00시
MAILBOX_CLEANUP_CRON=0 0 1 * *
# 만료된 지 이 개월 수보다 오래된 우편만 정리 삭제 대상
MAILBOX_CLEANUP_RETENTION_MONTHS=3
# 마스터 데이터 DB 버전과 메모리 캐시 버전을 비교하는 폴링 주기(ms) — Change Stream 유실 대비 fallback
MASTER_DATA_POLL_INTERVAL_MS=300000
# 로그인 세션 TTL(초) — Redis session:<token> 키 만료 시간
SESSION_TTL_SEC=604800
# 인벤토리 슬롯 상한(장 수) — 우편 수령(ClaimMail) 시점에 카드 첨부물 초과 여부를 검증한다
INVENTORY_SLOT_CAP=200
# 전투 출전 스쿼드 최대 장수
SQUAD_MAX_SIZE=5

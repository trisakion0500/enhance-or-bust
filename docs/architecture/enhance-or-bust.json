    { "what": "*.e2e.test.ts 전체, src/scripts/seedMasterData.ts, 각 컨텍스트의 seedData.ts", "why": "테스트/시드 스크립트는 런타임 서비스 아키텍처가 아니라 개발 보조 도구" },
    { "what": "env 키 하나하나의 개별 노드화", "why": "config/env.ts 파일 하나(infra-env)로 집약 — 각 컨텍스트가 실제로 참조하는 키는 코드 evidence 라인에서 확인 가능해 개별 노드로 쪼개면 그래프만 커짐" }
  ]
}
